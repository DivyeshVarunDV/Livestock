datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // ADMIN, VETERINARIAN, TESTER, FARMER
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  phone        String?
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  farms                       Farm[]
  ownershipTransfersAsCurrent OwnershipTransfer[] @relation("CurrentOwner")
  ownershipTransfersAsNew     OwnershipTransfer[] @relation("NewOwner")
}

model Farm {
  id               String   @id @default(uuid())
  name             String
  farmerId         String?  @unique
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  ownerName        String // Plain text name of the owner
  fullName         String?
  mobileNumber     String?
  aadhaarNumber    String?
  governmentId     String?
  address          String
  village          String?
  district         String?
  state            String?
  contactNumber    String
  location         String // GPS coordinates or text address
  registrationDate DateTime @default(now())
  status           String   @default("ACTIVE")
  animals             Animal[]
  milkCollections     MilkCollection[]
  violations          Violation[]
  ownershipTransfersFrom OwnershipTransfer[] @relation("TransferFromFarm")
  ownershipTransfersTo   OwnershipTransfer[] @relation("TransferToFarm")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Animal {
  id                  String         @id @default(uuid())
  animalCode          String?        @unique
  tagNumber           String         @unique // RFID/Tag Number
  name                String
  species             String // CATTLE, SHEEP, PIG, GOAT, poultry, etc.
  breed               String
  gender              String // MALE, FEMALE
  dateOfBirth         DateTime?
  age                 Int // in months
  weight              Float // in kg
  color               String?
  identificationMark  String?
  photoUrl            String?
  registrationDate    DateTime @default(now())
  currentStatus       String? // ACTIVE, SOLD, DEAD, TRANSFERRED
  status              String // HEALTHY, UNDER_TREATMENT, QUARANTINED
  mrlStatus           String // CLEARED, CLEARING_SOON, DO_NOT_SELL
  farmId              String
  farm                Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  healthRecords       HealthRecord[]
  vaccinations        Vaccination[]
  treatments          Treatment[]
  prescriptions       Prescription[]
  milkCollections     MilkCollection[]
  violations          Violation[]
  ownershipTransfers  OwnershipTransfer[]
  amuRecords          AmuRecord[]
  withdrawalRecords   WithdrawalRecord[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model HealthRecord {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  recordCode       String?
  diseases         String
  symptoms         String?
  diagnosis        String
  treatment        String?
  medicine         String?
  treatmentNotes   String
  checkupDate      DateTime?
  nextCheckupDate  DateTime?
  notes            String?
  veterinarianId   String?
  veterinarianName String
  date             DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Vaccination {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccinationCode  String?
  vaccineName      String
  batchNumber      String?
  notes            String?
  vaccinationDate  DateTime
  nextDueDate      DateTime
  veterinarianId   String?
  veterinarianName String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Treatment {
  id                       String   @id @default(uuid())
  animalId                 String
  animal                   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  disease                  String?
  drugName                 String
  activeIngredient         String?
  dosage                   String
  route                    String?
  reason                   String?
  notes                    String?
  followUpRequired         Boolean  @default(false)
  treatmentStartDate       DateTime?
  treatmentEndDate         DateTime?
  administrationDate       DateTime
  withdrawalPeriod         Int // in days
  withdrawalCompletionDate DateTime
  veterinarianId           String?
  veterinarianName         String
  withdrawalRecords        WithdrawalRecord[]
  amuRecords               AmuRecord[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Prescription {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  medicine         String
  veterinarianId   String?
  veterinarianName String
  dosage           String
  duration         Int
  instructions     String
  prescriptionDate DateTime
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AmuRecord {
  id               String   @id @default(uuid())
  amuCode          String?
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  treatmentId      String?
  treatment        Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  medicine         String
  activeIngredient String?
  dosage           String
  route            String?
  startDate        DateTime?
  endDate          DateTime?
  reason           String?
  veterinarianId   String?
  veterinarianName String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WithdrawalRecord {
  id                 String   @id @default(uuid())
  withdrawalCode     String?
  treatmentId        String?
  treatment          Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  animalId           String
  animal             Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  productType        String
  medicine           String
  treatmentDate      DateTime
  withdrawalPeriod   Int
  withdrawalEndDate  DateTime
  status             String   @default("RESTRICTED")
  followUpRequired   Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MrlRule {
  id               String   @id @default(uuid())
  drugName         String
  species          String
  withdrawalPeriod Int // default in days
  mrlLimit         String? // e.g. "50 ug/kg"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([drugName, species])
}

model LedgerBlock {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  action       String
  recordId     String
  dataPayload  String
  previousHash String
  currentHash  String
}

model Inventory {
  id              String   @id @default(uuid())
  medicineName    String
  manufacturer    String
  batchNumber     String
  expiryDate      DateTime
  stock           Int
  minimumStock    Int      @default(10)
  supplier        String
  cost            Float    @default(0)
  storageLocation String   @default("Main Pharmacy Room")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      String   @default("GENERAL") // GENERAL, ALERT, WARNING, INFO
  read      Boolean  @default(false)
  entityId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  role      String?
  action    String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String // FARM, ANIMAL, TREATMENT, USER, SYSTEM, etc.
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?  @default("127.0.0.1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MilkCollection {
  id               String   @id @default(uuid())
  farmId           String
  farm             Farm     @relation(fields: [farmId], references: [id])
  animalId         String?
  animal           Animal?  @relation(fields: [animalId], references: [id])
  collectionCode   String?
  sourceReference  String?
  productType      String   @default("MILK")
  quantity         Float    // e.g. liters
  collectionDate   DateTime?
  date             DateTime
  collectionCenter String
  batchId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  violations       Violation[]
}

model MilkTest {
  id               String   @id @default(uuid())
  batchId          String
  sampleId         String?
  productType      String   @default("MILK")
  date             DateTime
  testDate         DateTime?
  type             String   // e.g. "ANTIBIOTIC_RESIDUE", "SOMATIC_CELL_COUNT"
  result           String   // PASS, FAIL, PENDING
  remarks          String?
  location         String
  testingLocation  String?
  recordedById     String?
  recordedByName   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Violation {
  id               String   @id @default(uuid())
  violationCode    String?
  farmId           String
  farm             Farm     @relation(fields: [farmId], references: [id])
  animalId         String?
  animal           Animal?  @relation(fields: [animalId], references: [id])
  collectionId     String?
  milkCollection   MilkCollection? @relation(fields: [collectionId], references: [id])
  batchId          String?
  productType      String?
  date             DateTime
  type             String   // e.g. "RESTRICTED_MILK_SUPPLY"
  evidence         String?
  status           String   @default("PENDING_INVESTIGATION") // PENDING_INVESTIGATION, UNDER_REVIEW, CONFIRMED, DISMISSED, RESOLVED
  adminRemarks     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OwnershipTransfer {
  id               String   @id @default(uuid())
  transferCode     String?
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id])
  currentOwnerId   String
  currentOwner     User     @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  newOwnerId       String
  newOwner         User     @relation("NewOwner", fields: [newOwnerId], references: [id])
  fromFarmId       String?
  fromFarm         Farm?    @relation("TransferFromFarm", fields: [fromFarmId], references: [id])
  toFarmId         String?
  toFarm           Farm?    @relation("TransferToFarm", fields: [toFarmId], references: [id])
  requestDate      DateTime @default(now())
  approvalDate     DateTime?
  approvedById     String?
  reason           String?
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  resolvedDate     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
