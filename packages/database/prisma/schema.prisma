datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // ADMIN, VETERINARIAN, FARMER
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  phone        String?
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  farms        Farm[]
}

model Farm {
  id            String   @id @default(uuid())
  name          String
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id])
  ownerName     String // Plain text name of the owner
  address       String
  contactNumber String
  location      String // GPS coordinates or text address
  animals       Animal[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Animal {
  id            String         @id @default(uuid())
  tagNumber     String         @unique // RFID/Tag Number
  name          String
  species       String // CATTLE, SHEEP, PIG, GOAT, poultry, etc.
  breed         String
  gender        String // MALE, FEMALE
  age           Int // in months
  weight        Float // in kg
  status        String // HEALTHY, UNDER_TREATMENT, QUARANTINED
  mrlStatus     String // CLEARED, CLEARING_SOON, DO_NOT_SELL
  farmId        String
  farm          Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]
  vaccinations  Vaccination[]
  treatments    Treatment[]
  prescriptions Prescription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model HealthRecord {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  diseases         String
  diagnosis        String
  treatmentNotes   String
  veterinarianId   String?
  veterinarianName String
  date             DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Vaccination {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineName      String
  vaccinationDate  DateTime
  nextDueDate      DateTime
  veterinarianId   String?
  veterinarianName String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Treatment {
  id                       String   @id @default(uuid())
  animalId                 String
  animal                   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  drugName                 String
  dosage                   String
  administrationDate       DateTime
  withdrawalPeriod         Int // in days
  withdrawalCompletionDate DateTime
  veterinarianId           String?
  veterinarianName         String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Prescription {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  medicine         String
  veterinarianId   String?
  veterinarianName String
  dosage           String
  duration         Int
  instructions     String
  prescriptionDate DateTime
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MrlRule {
  id               String   @id @default(uuid())
  drugName         String
  species          String
  withdrawalPeriod Int // default in days
  mrlLimit         String? // e.g. "50 ug/kg"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([drugName, species])
}

model LedgerBlock {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  action       String
  recordId     String
  dataPayload  String
  previousHash String
  currentHash  String
}

model Inventory {
  id              String   @id @default(uuid())
  medicineName    String
  manufacturer    String
  batchNumber     String
  expiryDate      DateTime
  stock           Int
  minimumStock    Int      @default(10)
  supplier        String
  cost            Float    @default(0)
  storageLocation String   @default("Main Pharmacy Room")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      String   @default("GENERAL") // GENERAL, ALERT, WARNING, INFO
  read      Boolean  @default(false)
  entityId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  role      String?
  action    String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String // FARM, ANIMAL, TREATMENT, USER, SYSTEM, etc.
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?  @default("127.0.0.1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
