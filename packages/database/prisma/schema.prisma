datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // ADMIN, VETERINARIAN, TESTER, FARMER
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, PENDING_APPROVAL
  phone        String?
  department   String?
  // Session & credential security
  tokenVersion        Int       @default(0) // bumped to revoke every issued JWT
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  mustChangePassword  Boolean   @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  farms        Farm[]
  ownershipTransfersAsCurrent OwnershipTransfer[] @relation("CurrentOwner")
  ownershipTransfersAsNew     OwnershipTransfer[] @relation("NewOwner")
  approvedTransfers           OwnershipTransfer[] @relation("ApprovedBy")
}

model Farm {
  id            String   @id @default(uuid())
  name          String
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id])
  ownerName     String // Plain text name of the owner
  fullName      String?
  farmerId      String?
  address       String
  contactNumber String
  location      String // GPS coordinates or text address
  village       String?
  district      String?
  state         String?
  mobileNumber  String?
  governmentId  String?
  registrationDate DateTime?
  farmStatus    String   @default("ACTIVE") // ACTIVE, INACTIVE
  animals       Animal[]
  milkTests     MilkTest[]
  violations    Violation[]
  milkCollections MilkCollection[]
  ownershipTransfersAsFrom    OwnershipTransfer[] @relation("FromFarm")
  ownershipTransfersAsTo      OwnershipTransfer[] @relation("ToFarm")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Animal {
  id            String         @id @default(uuid())
  tagNumber     String         @unique // RFID/Tag Number
  animalCode    String?        @unique
  name          String
  species       String // CATTLE, BUFFALO, GOAT, SHEEP, POULTRY, etc.
  breed         String
  gender        String // MALE, FEMALE
  dateOfBirth   DateTime?
  age           Int // in months
  weight        Float // in kg
  color         String?
  identificationMark String?
  photoUrl      String?
  registrationDate DateTime?
  currentStatus String?        @default("ACTIVE") // ACTIVE, SOLD, DEAD, TRANSFERRED
  status        String // HEALTHY, UNDER_TREATMENT, QUARANTINED
  mrlStatus     String // CLEARED, CLEARING_SOON, DO_NOT_SELL
  farmId        String
  farm          Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]
  vaccinations  Vaccination[]
  treatments    Treatment[]
  prescriptions Prescription[]
  withdrawalRecords WithdrawalRecord[]
  amuRecords        AmuRecord[]
  milkCollections   MilkCollection[]
  violations        Violation[]
  ownershipTransfers OwnershipTransfer[]
  milkTests         MilkTest[]
  medicineDispensings MedicineDispensing[]
  productClearances   ProductClearance[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model HealthRecord {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  recordCode       String?  @unique
  diseases         String
  symptoms         String?
  diagnosis        String
  treatment        String?
  medicine         String?
  treatmentNotes   String
  checkupDate      DateTime?
  nextCheckupDate  DateTime?
  notes            String?
  veterinarianId   String?
  veterinarianName String
  date             DateTime
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Vaccination {
  id               String   @id @default(uuid())
  vaccinationCode  String?  @unique
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineName      String
  disease          String?
  route            String?
  batchNumber      String?
  manufacturer     String?
  cost             Float?
  notes            String?
  vaccinationDate  DateTime
  nextDueDate      DateTime
  veterinarianId   String?
  veterinarianName String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Treatment {
  id                       String   @id @default(uuid())
  animalId                 String
  animal                   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  prescriptionId           String?
  prescription             Prescription? @relation(fields: [prescriptionId], references: [id])
  disease                  String?
  drugName                 String
  activeIngredient         String?
  dosage                   String
  route                    String?
  reason                   String?
  notes                    String?
  followUpRequired         Boolean  @default(false)
  treatmentStartDate       DateTime?
  treatmentEndDate         DateTime?
  administrationDate       DateTime
  withdrawalPeriod         Int // in days
  withdrawalCompletionDate DateTime
  veterinarianId           String?
  veterinarianName         String
  withdrawalRecords        WithdrawalRecord[]
  amuRecords               AmuRecord[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Prescription {
  id               String   @id @default(uuid())
  prescriptionCode String?  @unique
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  farmerId         String?
  medicine         String
  activeIngredient String?
  veterinarianId   String?
  veterinarianName String
  dosage           String
  route            String?
  frequency        String?
  duration         Int
  startDate        DateTime?
  endDate          DateTime?
  instructions     String
  applicableWithdrawalPeriod Int?
  prescriptionDate DateTime
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  treatments       Treatment[]
  dispensingRecords MedicineDispensing[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MrlRule {
  id               String   @id @default(uuid())
  drugName         String
  species          String
  withdrawalPeriod Int // default in days
  mrlLimit         String? // e.g. "50 ug/kg"
  substance        String?
  applicableTissue String? // milk, meat, eggs, etc.
  unit             String?
  reference        String?
  effectiveDate    DateTime?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([drugName, species])
}

model LedgerBlock {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  action       String
  recordId     String
  dataPayload  String
  previousHash String
  currentHash  String
}

model Inventory {
  id               String   @id @default(uuid())
  medicineName     String
  manufacturer     String
  batchNumber      String
  expiryDate       DateTime
  stock            Int
  minimumStock     Int      @default(10)
  supplier         String
  cost             Float    @default(0)
  storageLocation  String   @default("Main Pharmacy Room")
  withdrawalPeriod Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  targetRole String? // when set (and userId is null) only users of this role see it
  title     String
  message   String
  type      String   @default("GENERAL") // GENERAL, ALERT, WARNING, INFO
  read      Boolean  @default(false)
  entityId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  role      String?
  action    String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String // FARM, ANIMAL, TREATMENT, USER, SYSTEM, etc.
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?  @default("127.0.0.1")
  // Tamper-evident hash chain: hash = sha256(prevHash + canonical record)
  sequence  Int?     @unique
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entity, entityId])
}

model WithdrawalRecord {
  id                 String   @id @default(uuid())
  withdrawalCode     String?
  treatmentId        String
  treatment          Treatment @relation(fields: [treatmentId], references: [id])
  animalId           String
  animal             Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  productType        String
  medicine           String
  treatmentDate      DateTime
  withdrawalPeriod   Int
  withdrawalEndDate  DateTime
  status             String // RESTRICTED, WITHDRAWAL_COMPLETED
  followUpRequired   Boolean
  notes              String?
  productClearances  ProductClearance[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AmuRecord {
  id                 String   @id @default(uuid())
  amuCode            String?
  animalId           String
  animal             Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  treatmentId        String
  treatment          Treatment @relation(fields: [treatmentId], references: [id])
  medicine           String
  activeIngredient   String?
  dosage             String
  route              String?
  startDate          DateTime
  endDate            DateTime?
  reason             String?
  veterinarianId     String?
  veterinarianName   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MilkCollection {
  id                 String   @id @default(uuid())
  batchId            String?  @unique
  collectionCode     String?  @unique
  productType        String?
  collectionCenter   String?
  quantity           Float?
  collectionDate     DateTime?
  date               DateTime?
  sourceReference    String?
  animalId           String
  animal             Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  farmId             String?
  farm               Farm?    @relation(fields: [farmId], references: [id])
  collectionBatchId  String?
  collectionBatch    CollectionBatch? @relation(fields: [collectionBatchId], references: [id])
  violations         Violation[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Violation {
  id                 String   @id @default(uuid())
  violationCode      String?  @unique
  farmId             String?
  farm               Farm?    @relation(fields: [farmId], references: [id])
  animalId           String?
  animal             Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type               String
  description        String?
  severity           String
  productType        String?
  date               DateTime
  status             String
  resolvedDate       DateTime?
  notes              String?
  veterinarianId     String?
  veterinarianName   String?
  collectionId       String?
  milkCollection     MilkCollection? @relation(fields: [collectionId], references: [id])
  batchId            String?
  evidence           String?
  adminRemarks       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model OwnershipTransfer {
  id                 String   @id @default(uuid())
  transferCode       String?  @unique
  animalId           String
  animal             Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  requestDate        DateTime
  status             String   @default("PENDING")
  reason             String?
  approvalDate       DateTime?
  resolvedDate       DateTime?
  notes              String?
  rejectionReason    String?
  requestedById      String?
  requestedByName    String?
  approvedById       String?
  approvedBy         User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  currentOwnerId     String?
  currentOwner       User?    @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  newOwnerId         String?
  newOwner           User?    @relation("NewOwner", fields: [newOwnerId], references: [id])
  fromFarmId         String?
  fromFarm           Farm?    @relation("FromFarm", fields: [fromFarmId], references: [id])
  toFarmId           String?
  toFarm             Farm?    @relation("ToFarm", fields: [toFarmId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MilkTest {
  id                 String   @id @default(uuid())
  testCode           String?
  sampleId           String?
  batchId            String?
  productType        String?
  type               String?
  location           String?
  testingLocation    String?
  recordedById       String?
  recordedByName     String?
  farmId             String?
  farm               Farm?    @relation(fields: [farmId], references: [id])
  animalId           String?
  animal             Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  testDate           DateTime
  date               DateTime?
  result             String
  notes              String?
  substance          String?
  measuredValue      Float?
  measuredUnit       String?
  applicableMRLValue Float?
  complianceStatus   String? // COMPLIANT, NON_COMPLIANT, NOT_EVALUATED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ==========================================
// NEW MODELS
// ==========================================

model MedicineDispensing {
  id              String   @id @default(uuid())
  dispensingCode  String?  @unique
  prescriptionId  String
  prescription    Prescription @relation(fields: [prescriptionId], references: [id])
  animalId        String
  animal          Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  medicine        String
  quantity        Float
  dispensedDate   DateTime
  dispensedBy     String
  dispensedById   String?
  batchNumber     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CollectionBatch {
  id               String   @id @default(uuid())
  batchCode        String   @unique
  productType      String
  collectionDate   DateTime
  collectionCenter String?
  status           String   @default("CREATED") // CREATED, COLLECTED, TESTING, PASSED, FAILED, UNDER_INVESTIGATION, RELEASED, REJECTED
  notes            String?
  collections      MilkCollection[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductClearance {
  id                  String   @id @default(uuid())
  animalId            String
  animal              Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  productType         String // MILK, MEAT, EGGS, OTHER
  status              String // CLEARED, RESTRICTED, UNDER_INVESTIGATION
  reason              String?
  restrictionStart    DateTime?
  restrictionEnd      DateTime?
  relatedWithdrawalId String?
  relatedWithdrawal   WithdrawalRecord? @relation(fields: [relatedWithdrawalId], references: [id])
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}