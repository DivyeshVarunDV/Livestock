datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // ADMIN, VETERINARIAN, FARMER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  farms        Farm[]
}

model Farm {
  id            String   @id @default(uuid())
  name          String
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id])
  ownerName     String   // Plain text name of the owner
  address       String
  contactNumber String
  location      String   // GPS coordinates or text address
  animals       Animal[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Animal {
  id            String   @id @default(uuid())
  tagNumber     String   @unique // RFID/Tag Number
  name          String
  species       String   // CATTLE, SHEEP, PIG, GOAT, poultry, etc.
  breed         String
  gender        String   // MALE, FEMALE
  age           Int      // in months
  weight        Float    // in kg
  status        String   // HEALTHY, UNDER_TREATMENT, QUARANTINED
  mrlStatus     String   // CLEARED, CLEARING_SOON, DO_NOT_SELL
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]
  vaccinations  Vaccination[]
  treatments    Treatment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HealthRecord {
  id             String   @id @default(uuid())
  animalId       String
  animal         Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  diseases       String
  diagnosis      String
  treatmentNotes String
  veterinarianId String?
  veterinarianName String
  date           DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vaccination {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineName      String
  vaccinationDate  DateTime
  nextDueDate      DateTime
  veterinarianId   String?
  veterinarianName String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Treatment {
  id                       String   @id @default(uuid())
  animalId                 String
  animal                   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  drugName                 String
  dosage                   String
  administrationDate       DateTime
  withdrawalPeriod         Int      // in days
  withdrawalCompletionDate DateTime
  veterinarianId           String?
  veterinarianName         String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model MrlRule {
  id               String   @id @default(uuid())
  drugName         String
  species          String
  withdrawalPeriod Int      // default in days
  mrlLimit         String?  // e.g. "50 ug/kg"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([drugName, species])
}

model LedgerBlock {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  action       String   
  recordId     String
  dataPayload  String   
  previousHash String
  currentHash  String   
}
