# Copy to .env (never commit the real file).

# REQUIRED in production: random secret of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session lifetime (a working shift by default).
JWT_EXPIRES_IN=8h

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false
BODY_LIMIT=5mb

# Credential protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_WINDOW_MS=60000
LOGIN_RATE_MAX=20
# Farmer self-registration (creates PENDING_APPROVAL farmer accounts only). Off by default.
ALLOW_SELF_REGISTRATION=false

# How often withdrawal / clearance state is re-evaluated in the background (0 disables).
COMPLIANCE_SWEEP_MINUTES=60

# Hyperledger Fabric (optional). When unreachable, the local hash-chained ledger is used.
FABRIC_ENABLED=true
# FABRIC_CHANNEL_NAME=mychannel
# FABRIC_CHAINCODE_NAME=livestock
# FABRIC_MSP_ID=Org1MSP
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# FABRIC_CRYPTO_PATH=
